{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.envrc)",
      "Read(**/*.env)",
      "Read(**/*.env.local)",
      "Read(**/*.env.*.local)",
      "Read(**/*.env.production)",
      "Read(**/*.env.prod)",
      "Read(**/*.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/*service-account*.json)",
      "Read(**/*credentials*.json)",
      "Read(**/secrets/**)",
      "Read(**/.netrc)",
      "Read(**/.pgpass)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "project-init": {
      "source": {
        "source": "github", "repo": "VytCepas/project-init"
      }
    }
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "project-init-workflow@project-init": true,
    "project-init-lifecycle@project-init": true
  }
}
