# fleet.yaml — which projects this orchestrator governs.
#
# Copy to `fleet.yaml` (gitignored — the fleet is machine-specific) and
# adjust. Without this file the orchestrator scans $PO_FLEET_ROOT, else the
# directory the repositories live in side by side: $PORT_ROOT, else ~/port.
#
# Paths may be absolute, ~-relative, or relative to this file.

# Directories scanned one level deep; anything with .claude/config.yaml counts.
# `..` is the directory this checkout sits in, which is $PORT_ROOT when the
# orchestrator lives at $PORT_ROOT/projects-orchestrator like its siblings.
# YAML expands no variables: if the checkout lives elsewhere, spell the root.
roots:
  - ..

# Explicit project paths outside the roots.
projects: []
#  - ~/work/some-other-project

# Directory-name patterns (fnmatch) to skip while scanning roots.
exclude: []
#  - archive-*

# Also govern plain git repos (no .claude/config.yaml) with a minimal
# inferred descriptor: language + lint/test/run from justfile / package.json
# scripts / pyproject / Cargo.toml / go.mod conventions. Off by default.
include_plain_repos: false

# Extra memory directories that `memory` search reads beside every project's
# own, in the same memory-file format, and ranks in the same corpus. Hits are
# labelled with the directory's path. A missing or unreadable directory is
# warned about, never silently skipped.
memory_sources: []
#  - ~/notes/memory

# A command whose first output line is the fleet view's host-health tile: under
# the `status` and `snapshot` tables, on the HTML and live dashboards, and in the
# TUI header. Run as an argv, never through a shell, with a 5 s timeout. The
# tile reads `host: unknown` when this is absent, fails, times out or prints
# nothing, never blank and never "ok" by default.
# host_health_command: ~/bin/host-health --one-line
